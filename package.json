{
  "name": "gumnut-sdk",
  "version": "0.185.0",
  "description": "The official TypeScript library for the Gumnut API",
  "author": "Gumnut <tedmao@gmail.com>",
  "types": "dist/index.d.ts",
  "main": "dist/index.js",
  "type": "commonjs",
  "repository": "github:gumnut-ai/photos-sdk-typescript",
  "license": "Apache-2.0",
  "packageManager": "bun@1.4.2",
  "files": [
    "**/*"
  ],
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "./scripts/test",
    "build": "./scripts/build",
    "check-package": "./scripts/check-package",
    "prepublishOnly": "echo 'to publish, run bun run build && (cd dist; npm publish)' && exit 1",
    "format": "./scripts/format",
    "prepare": "if ./scripts/utils/check-is-in-git-install.sh; then ./scripts/build && ./scripts/utils/git-swap.sh; fi",
    "lint": "./scripts/lint",
    "fix": "./scripts/format"
  },
  "dependencies": {},
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "2.5.3",
    "@types/node": "^20.19.43",
    "iconv-lite": "^0.6.3",
    "prettier": "^3.0.0",
    "publint": "^0.2.12",
    "tsc-multi": "https://github.com/stainless-api/tsc-multi/releases/download/v1.1.11/tsc-multi.tgz",
    "tslib": "^2.8.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "minimatch": "^9.0.5"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./*.mjs": {
      "default": "./dist/*.mjs"
    },
    "./*.js": {
      "default": "./dist/*.js"
    },
    "./*": {
      "import": "./dist/*.mjs",
      "require": "./dist/*.js"
    }
  }
}
