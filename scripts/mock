#!/usr/bin/env bash

set -e

cd "$(dirname "$0")/.."

if [ "$1" == "--install" ]; then
  npm exec --package=@stdy/cli@0.22.1 -- steady --version
  exit 0
fi

if [[ -n "$1" && "$1" != '--'* ]]; then
  URL="$1"
  shift
elif [ -n "$STAINLESS_OPENAPI_SPEC_URL" ]; then
  URL="$STAINLESS_OPENAPI_SPEC_URL"
else
  # Embedded OpenAPI spec (base64-encoded, gzipped)
  EMBEDDED_SPEC=""
  SPEC_TMPFILE="$(mktemp)"
  trap 'rm -f "$SPEC_TMPFILE"' EXIT
  echo "$EMBEDDED_SPEC" | base64 -d | gunzip > "$SPEC_TMPFILE"
  URL="$SPEC_TMPFILE"
fi

echo "==> Starting mock server with URL ${URL}"

# Run steady mock on the given spec
MOCK_PORT="${STAINLESS_MOCK_PORT:-4010}"

npm exec --package=@stdy/cli@0.22.1 -- steady --generator-seed=0 --host 127.0.0.1 -p "$MOCK_PORT" --validator-query-array-format=repeat --validator-form-array-format=brackets --validator-query-object-format=brackets --validator-form-object-format=brackets "$URL"
