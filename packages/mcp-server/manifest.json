{
  "dxt_version": "0.2",
  "name": "gumnut-sdk-mcp",
  "version": "0.32.0",
  "description": "The official MCP Server for the Gumnut API",
  "author": {
    "name": "Gumnut",
    "email": "tedmao@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gumnut-ai/photos-sdk-typescript.git"
  },
  "homepage": "https://github.com/gumnut-ai/photos-sdk-typescript/tree/main/packages/mcp-server#readme",
  "documentation": "https://api.gumnut.ai/redoc",
  "server": {
    "type": "node",
    "entry_point": "index.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/index.js"],
      "env": {
        "GUMNUT_API_KEY": "${user_config.GUMNUT_API_KEY}"
      }
    }
  },
  "user_config": {
    "GUMNUT_API_KEY": {
      "title": "api_key",
      "description": "",
      "required": false,
      "type": "string"
    }
  },
  "tools": [],
  "tools_generated": true,
  "compatibility": {
    "runtimes": {
      "node": ">=18.0.0"
    }
  },
  "keywords": ["api"]
}
